# Copy this file to .env.local and fill in both values.
# Get them from https://appatools.com/mcp-studio-sdk/portal
#
# The app will not render the embed until both are set. That is deliberate:
# a half-configured embed teaches the wrong integration.

# Public. This reaches the browser, which is expected and fine.
MCP_STUDIO_CLIENT_ID=your_client_id_here

# Secret. Server-side only.
# Never rename this to NEXT_PUBLIC_MCP_STUDIO_CLIENT_SECRET — Next.js inlines
# NEXT_PUBLIC_* variables into the JavaScript bundle, which would hand your
# secret to every visitor.
MCP_STUDIO_CLIENT_SECRET=your_client_secret_here

# Optional. Only change these if you are pointing at a non-production
# MCP Studio instance.
# MCP_STUDIO_BASE_URL=https://appatools.com/mcp-studio-sdk
# NEXT_PUBLIC_MCP_STUDIO_EMBED_URL=https://appatools.com/mcp-studio-sdk/embed.js
