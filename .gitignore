# Node / Next
node_modules
.next
dist

# secrets — never commit
# .env.* covers named environments (.env.production, .env.staging, ...),
# which the earlier .env.*.local pattern let through. The per-app
# .env.example templates stay tracked via the negation.
.env
.env.*
!.env.example

# .projects/ is Stripe Projects CLI state; state.local.json holds credentials.
.projects/

# private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Mac
.DS_Store

*.tsbuildinfo
